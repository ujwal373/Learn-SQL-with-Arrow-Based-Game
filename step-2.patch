@@ -0,0 +1,13 @@
+// Small seeded random number generator (mulberry32).
+// Seeding means the same level number always produces the same board, which makes
+// levels testable, shareable and easy to debug.
+export function mulberry32(seed: number): () => number {
+  let a = seed >>> 0
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0
+    let t = a
+    t = Math.imul(t ^ (t >>> 15), t | 1)
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61)
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
+  }
+}
