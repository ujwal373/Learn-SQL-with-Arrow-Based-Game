@@ -0,0 +1,123 @@
+/* The board is a square. Arrows are absolutely positioned using percentages,
+   so the whole board scales with its container and works on phones. */
+.board {
+  --dot: rgba(138, 145, 180, 0.35);
+  position: relative;
+  width: 100%;
+  aspect-ratio: 1 / 1;
+  border-radius: 20px;
+  background-color: var(--panel);
+  background-image: radial-gradient(circle, var(--dot) 1.5px, transparent 2px);
+  background-size: calc(100% / var(--cols)) calc(100% / var(--rows));
+  /* Clips arrows as they fly past the edge, so they look like they leave the board. */
+  overflow: hidden;
+  touch-action: manipulation;
+}
+
+.arrow {
+  position: absolute;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--accent);
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.arrow__face {
+  position: absolute;
+  inset: 10%;
+  display: grid;
+  place-items: center;
+  border-radius: 14px;
+  background: var(--tile);
+  box-shadow: inset 0 0 0 1.5px rgba(94, 234, 212, 0.25);
+  transition:
+    transform 120ms ease,
+    box-shadow 120ms ease,
+    background-color 120ms ease;
+}
+
+.arrow svg {
+  width: 58%;
+  height: 58%;
+}
+
+.arrow:hover .arrow__face {
+  transform: scale(1.06);
+}
+
+.arrow:active .arrow__face {
+  transform: scale(0.96);
+}
+
+.arrow:focus-visible {
+  outline: none;
+}
+
+.arrow:focus-visible .arrow__face {
+  box-shadow: 0 0 0 3px var(--text);
+}
+
+/* Blocked tap: the tapped arrow shakes and turns red, the arrow in its way gets a red ring. */
+.arrow--shake-a {
+  animation: shake-a 400ms ease-in-out;
+}
+
+.arrow--shake-b {
+  animation: shake-b 400ms ease-in-out;
+}
+
+.arrow--shake-a .arrow__face,
+.arrow--shake-b .arrow__face {
+  background: var(--danger-tint);
+  box-shadow: inset 0 0 0 1.5px var(--danger);
+}
+
+.arrow--blocker .arrow__face {
+  box-shadow: 0 0 0 3px var(--danger);
+}
+
+@keyframes shake-a {
+  0%, 100% { transform: translateX(0); }
+  20% { transform: translateX(-9%); }
+  40% { transform: translateX(8%); }
+  60% { transform: translateX(-6%); }
+  80% { transform: translateX(4%); }
+}
+
+@keyframes shake-b {
+  0%, 100% { transform: translateX(0); }
+  20% { transform: translateX(-9%); }
+  40% { transform: translateX(8%); }
+  60% { transform: translateX(-6%); }
+  80% { transform: translateX(4%); }
+}
+
+/* Cleared arrow: flies off in the direction it points, then fades near the end.
+   --dx and --dy are set per arrow in Board.tsx, in cell widths. */
+.arrow--exiting {
+  pointer-events: none;
+  z-index: 1;
+  opacity: 0;
+  transform: translate(calc(var(--dx) * 100%), calc(var(--dy) * 100%));
+  transition:
+    transform var(--exit-ms) cubic-bezier(0.45, 0, 0.85, 0.35),
+    opacity calc(var(--exit-ms) * 0.4) ease-in calc(var(--exit-ms) * 0.55);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .arrow--shake-a,
+  .arrow--shake-b {
+    animation: none;
+  }
+
+  .arrow--exiting {
+    transform: none;
+    transition: opacity 150ms linear;
+  }
+
+  .arrow__face {
+    transition: none;
+  }
+}
