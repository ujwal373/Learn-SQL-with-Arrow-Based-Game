# Copy this file to .env.local for local Vercel dev (vercel dev).
# Set the same variables in Vercel: Project > Settings > Environment Variables.
# These are read only by serverless functions in api/ and never reach the browser.

# Step 5 — Google Sheets question bank (read-only, API key is enough)
# Create a key at console.cloud.google.com > APIs & Services > Credentials.
# Restrict it to the Sheets API and your Vercel domain.
GOOGLE_SHEETS_API_KEY=

# The long ID from your spreadsheet URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Step 6 — Leaderboard (requires a service account for write access)
# Create a service account at console.cloud.google.com > APIs & Services > Credentials.
# Download the JSON key file and copy service_account_email and private_key from it.
# Share the spreadsheet with the service account email as Editor.
# Paste the private key with literal \n between lines (Vercel replaces them at runtime).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
