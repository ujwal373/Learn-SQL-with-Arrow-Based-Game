# Copy this file to .env.local for local work. Never commit real values.
# These are set in the Vercel dashboard for production (Project Settings, Environment Variables).
# They are read only by serverless functions in /api and never reach the browser.

# Google service account used to read the question bank and write the leaderboard
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Sheet IDs (the long id in each Google Sheet URL)
QUESTIONS_SHEET_ID=
LEADERBOARD_SHEET_ID=
